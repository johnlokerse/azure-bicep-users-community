---
import type { PostCategory } from '../data/posts';

interface Props {
  category: PostCategory;
  size?: number;
}

const { category, size = 16 } = Astro.props;
const hex = 'M8 1 14.5 4.75v7.5L8 16 1.5 12.25v-7.5Z';
---

<svg
  class="hex-icon"
  width={size}
  height={size}
  viewBox="0 0 16 17"
  aria-hidden="true"
  focusable="false"
>
  {category === 'BicepTip' && <path d={hex} fill="currentColor" />}
  {category === 'BicepDidYouKnow' && (
    <>
      <path d={hex} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <circle cx="8" cy="8.5" r="2.2" fill="currentColor" />
    </>
  )}
  {category === 'BicepPoll' && (
    <>
      <path d={hex} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M5.5 11V8.5M8 11V6M10.5 11V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </>
  )}
  {category === 'ExperimentalSpotlight' && (
    <path d={hex} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-dasharray="2.4 1.8" />
  )}
  {category === 'CommunitySpotlight' && (
    <>
      <path d={hex} fill="currentColor" />
      <circle cx="8" cy="8.5" r="2.4" fill="none" stroke="#fff" stroke-width="1.4" />
    </>
  )}
</svg>
