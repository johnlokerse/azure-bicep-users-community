---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Azure Bicep Users Community',
  description = 'Every Bicep Tip, Did You Know, poll, and spotlight from the Azure Bicep Users Community, hosted by John Lokerse and Dan Rios.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b578e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#archive">Skip to the archive</a>
    <slot />
  </body>
</html>
